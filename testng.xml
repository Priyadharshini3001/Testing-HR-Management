<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="HR Automation Suite">

    <listeners>
        <listener class-name="com.qualityhr.listeners.TestListener"/>
    </listeners>

    <test name="HR Tests">

        <classes>

